{
  "name": "galaxy-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "redis:start": "docker-compose up -d redis",
    "redis:stop": "docker-compose stop redis",
    "redis:restart": "docker-compose restart redis",
    "redis:logs": "docker-compose logs redis",
    "redis:health": "curl http://localhost:3000/api/health/redis",
    "redis:health:3000": "curl http://localhost:3000/api/health/redis",
    "redis:health:3001": "curl http://localhost:3001/api/health/redis",
    "redis:cli": "docker exec -it galaxy-redis redis-cli",
    "postgres:cli": "docker exec -it galaxy-postgres psql -U postgres -d galaxy_erp",
    "infra:start": "docker-compose up -d",
    "infra:stop": "docker-compose down",
    "infra:logs": "docker-compose logs -f",
    "setup:managers": "./scripts/setup-managers.sh",
    "create:managers": "node scripts/create-managers.js",
    "db:seed": "prisma db seed",
    "db:clear": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/clear-db.ts",
    "postman:generate": "node scripts/generate-postman.js",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && (prisma migrate deploy || prisma db push --accept-data-loss --skip-generate || true) && (npm run db:seed || true) && next build"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "@prisma/client": "^5.4.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@react-email/render": "^1.4.0",
    "@sendgrid/mail": "^8.1.6",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-table": "^8.10.3",
    "autoprefixer": "^10.4.16",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "framer-motion": "^11.0.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.540.0",
    "next": "15.5.0",
    "next-auth": "^4.24.5",
    "node-fetch": "^3.3.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.49.0",
    "recharts": "^2.10.3",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.4",
    "@types/node": "24.10.0",
    "@types/react": "18.3.26",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "13.5.4",
    "prisma": "^5.4.2",
    "ts-node": "^10.9.1"
  }
}
